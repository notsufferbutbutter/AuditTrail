# Copy this file to .env for local use. Never commit .env.
# Exact address of the website without a trailing slash:
#   Angular dev server: http://localhost:4200
#   Docker locally:     http://localhost:8000
#   Cloud:              your public https:// address
APP_ORIGIN=http://localhost:4200

# Optional. These defaults are already built into the app.
# ENTRA_TENANT_ID=0765b62a-fce8-4923-8bf6-390ec4b8308e
# ENTRA_FRONTEND_CLIENT_ID=0cb0559f-af7b-4744-a42f-181a5b118aa6
# ENTRA_BACKEND_CLIENT_ID=072934a6-6fa6-4a83-b2ef-ed86d55e6803
# SESSION_SECONDS=3600
